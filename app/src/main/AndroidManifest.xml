<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Notifications (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Exact alarm for scheduled reminders (Android 12+) -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Alarm/reminder-class apps get exact alarms without user opt-in on Android 13+.
         Without this, targetSdk>=33 apps default to DENIED and every reminder silently
         degrades to setAndAllowWhileIdle (i.e. the system is free to delay it). -->
    <uses-permission
        android:name="android.permission.USE_EXACT_ALARM"
        android:minSdkVersion="33" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 「提醒可靠性」里引导用户把本应用加入电池优化白名单。
         ⚠️ Play 政策：只允许核心功能确实依赖它的应用使用，且必须由用户主动点击触发，
         不能在启动时自己弹（详见 docs/BACKGROUND.md §10）。 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- 可选常驻服务（设置→后台增强）使用 specialUse 类型。
         不用 dataSync：Android 15 起 BOOT_COMPLETED 不允许启动 dataSync 类型的前台服务。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- ★ 本应用不申请任何网络权限（v1.0.0 起）。
         应用内「检查更新」已下线，全部功能离线可用；关于页的 GitHub / 博客链接走
         ACTION_VIEW 交给浏览器打开，联网的是浏览器，不是本应用。
         这是国内应用商店上架的硬性前提之一 —— 同时也是「数据只在本地」这句话的依据。

         ★ tools:node="remove" 是必需的：androidx.work 的 manifest 会自己声明
         ACCESS_NETWORK_STATE（WorkManager 用它判断联网状态），合并后就会出现在最终包里。
         本应用不用它的网络感知能力，显式移除，避免审核看到「声明了网络权限却说不联网」。
         （INTERNET 不会被任何依赖注入，删掉即可，无需 remove。） -->
    <uses-permission
        android:name="android.permission.ACCESS_NETWORK_STATE"
        tools:node="remove" />

    <application
        android:name=".OnelineApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Oneline">

        <!-- ★ MainActivity 用 singleTask：全系统只保留一个实例。
             原来（默认 standard）从小组件点进来时，PendingIntent.getActivity 会带
             FLAG_ACTIVITY_NEW_TASK，同 affinity 的 task 被复用后仍然会**再压一个
             MainActivity 实例**堆在旧的上面 —— 用户按返回看到的是下面那个实例，
             也就是"返回后还有一个主页面"，要点两次才能真正退出。
             配 singleTask 后任何入口（小组件 / 通知 / 桌面图标）都复用同一个实例。 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Reminder alarm receiver: delivers the notification for a scheduled reminder -->
        <receiver
            android:name=".reminder.ReminderReceiver"
            android:exported="false" />

        <!-- Notification action buttons 「完成」/「撤回」. Not exported: only our own
             PendingIntents (from the notification) may target it. -->
        <receiver
            android:name=".reminder.NotificationActionReceiver"
            android:exported="false" />

        <!-- 闹钟重建入口。三个 action 缺一不可：
             BOOT_COMPLETED      重启后重建
             MY_PACKAGE_REPLACED 升级安装会杀进程并清空该包全部闹钟 —— 不处理的话
                                 用户每升一次级，此前所有提醒都不响（v0.5 之前就是这样）
             TIME_SET            用户改系统时间；RTC 闹钟是绝对 epoch，必须按新墙钟重排
             （TIMEZONE_CHANGED 不需要：所有日期都在固定时区 AppTime.ZONE 里解析） -->
        <receiver
            android:name=".reminder.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
            </intent-filter>
        </receiver>

        <!-- 可选常驻服务（设置→后台增强，默认开）。
             type=specialUse 的理由：Android 15 / target 35+ 禁止 BOOT_COMPLETED 启动
             dataSync / camera / mediaPlayback 等六种类型的前台服务，specialUse 不在其列。
             <property> 里的 PROPERTY_SPECIAL_USE_FGS_SUBTYPE 是 Android 14+ 对
             specialUse 的必填说明（商店审核会读它）。 -->
        <service
            android:name=".keepalive.KeepAliveService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="日程提醒常驻：用于及时响应提醒通知上的操作，用户可在设置里关闭" />
        </service>

        <!-- 桌面小组件：一个 provider，纵横可拉。2×2 = 紧凑行 4 条；拉高 = 标准行 6 条。
             ★ exported=true 是故意的：部分国产 Launcher（澎湃/vivo 实测）bind 组件时
             不是特权身份，exported=false 会导致组件进不了系统列表（v0.8.1 的 404 根因）。
             intent-filter 只挂系统的 APPWIDGET_UPDATE，完成动作在独立的
             TodoWidgetActionReceiver（exported=false），不对外暴露。 -->
        <receiver
            android:name=".widget.TodoWidgetProvider"
            android:exported="true"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <!-- ★ meta-data 的 name 必须是 android.appwidget.provider（系统靠它发现组件）。
                 v0.8.0/0.8.1 误写成了 action 名，系统扫描时静默跳过 ——
                 61 个组件里永远没有我们、无报错、重启换渠道都无效的真因。 -->
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/todo_widget_info" />
        </receiver>

        <!-- 小组件「圆圈完成」。exported=false：只有我们自己的 PendingIntent（显式
             ComponentName）能投递；第三方应用伪造 COMPLETE 完成任意待办的路被堵死。 -->
        <receiver
            android:name=".widget.TodoWidgetActionReceiver"
            android:exported="false" />

    </application>

</manifest>
