<?xml version="1.0" encoding="utf-8"?>
<!--
  Widget 主布局：头部 + 行容器 + 空状态。

  ★ v0.8.1 重构：不用 ListView + RemoteViewsService —— vivo 桌面（com.bbk.launcher2）
  实测从不绑定数据服务（onDataSetChanged 一次都不跑，列表恒空）。
  行数本来就是固定的（恒 4 条），所以改成
  updateOne 里用 RemoteViews.addView 直接把行塞进 widget_rows 容器：
  数据同步构建、无 bind、无 factory，任何 ROM 都没有兼容性问题。

  ★ 行布局不再按尺寸切（vivo 报的 AppWidgetOptions 尺寸恒为 152px，不可信），
  改由设置决定：widget_item_todo（日期在右）/ widget_item_todo_below（日期在下）/
  widget_item_todo_nodate（不显示日期）。三张布局的根节点都带 layout_weight="1"，
  4 行平分 widget_rows 的高度 —— 隐藏头部后多出的空间由 4 行吃掉，底部不留空。
  ★ 条数恒为 4 条，不随尺寸 / 隐藏头部变化。
  ★ updateOne 里每次都要先 removeAllViews(R.id.widget_rows) 再 addView ——
    桌面复用视图树时 addView 是追加，不清空会堆出多余的历史行。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/widget_bg"
    android:orientation="vertical">

    <!-- 头部：标题 + 条数。点头部（列表以外的空白）= 打开 App。 -->
    <LinearLayout
        android:id="@+id/widget_header"
        android:layout_width="match_parent"
        android:layout_height="26dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/widget_header"
            android:textColor="@color/widget_text"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/widget_text_secondary"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- 行容器：内容由 updateOne 动态塞入（RemoteViews.addView）。
         行自带 weight，4 行会平分这里的高度；底部只留 2dp，避免隐藏头部后看得出空隙。 -->
    <LinearLayout
        android:id="@+id/widget_rows"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingBottom="2dp" />

    <!-- 空状态：没有待办时显示（visibility 由代码切换）。 -->
    <TextView
        android:id="@+id/widget_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="@string/widget_empty"
        android:textColor="@color/widget_text_secondary"
        android:textSize="13sp"
        android:visibility="gone" />
</LinearLayout>
