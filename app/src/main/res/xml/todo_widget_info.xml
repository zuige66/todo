<?xml version="1.0" encoding="utf-8"?>
<!--
  Widget 提供者配置。

  - minWidth/minHeight = 2×2 的最小尺寸（dp，Android 按 cell 换算的经验值）
  - minResizeWidth/Height 允许用户拉到更小（4 格宽以内的任意组合）
  - resizeMode 纵横都可拉：拉高就自动从紧凑行换成标准行、显示更多条
  - targetCellWidth/Height = 2×2：加组件时默认就是这个尺寸
  - previewLayout（API 31+）比 previewImage 更真实，但需要额外一张 XML 布局；
    先用 previewImage（layer-list 画的缩略图），低版本也兼容
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_description"
    android:initialLayout="@layout/widget_todo_list"
    android:minHeight="160dp"
    android:minResizeHeight="120dp"
    android:minResizeWidth="120dp"
    android:minWidth="160dp"
    android:previewImage="@drawable/widget_preview"
    android:previewLayout="@layout/widget_preview_layout"
    android:resizeMode="horizontal|vertical"
    android:targetCellHeight="2"
    android:targetCellWidth="2"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen" />
