<?xml version="1.0" encoding="utf-8"?>
<!--
  「关于」页的 Logo 标记（白色心形 + 背景色竖条，竖条压在心上形成一道缺口）。

  为什么不直接复用现成的两个文件：

  1. `mipmap-anydpi-v26/ic_launcher.xml` —— 它是 <adaptive-icon>，根节点不是 <vector>。
     Compose 的 painterResource 只认 <vector>（见 PainterResources.android.kt 的
     `if (parser.seekToStartTag().name != "vector") throw IllegalArgumentException`），
     拿它去画会在组合这一帧直接崩溃。关于页闪退就是这一行造成的。

  2. `drawable/ic_launcher_foreground.xml` —— 它是为 108dp 自适应图标画的：
     group translate(28,28) + scale(0.6)，内容只落在 (0..20, 4..24) 这一小块，
     直接当普通图标渲染会又小又偏左上。

  所以这里把同样的两条 path 原样搬过来，用 group 的 translate 把
  并集包围盒 (0..20, 4..24)（20x20）挪到 24x24 viewport 的正中：
  offsetX = (24-20)/2 - 0 = 2，offsetY = (24-20)/2 - 4 = -2。
  改动图形时记得同步改 drawable/ic_launcher_foreground.xml，两处是同一个标记。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <group
        android:translateX="2"
        android:translateY="-2">
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M12,20 C12,20 4,14 4,8.5 C4,5.5 6,4 8,4 C9.5,4 11,4.8 12,6 C13,4.8 14.5,4 16,4 C18,4 20,5.5 20,8.5 C20,14 12,20 12,20 Z" />
        <path
            android:fillColor="#00696A"
            android:pathData="M0,24 L0,10 C0,9 1,8 2,8 L5,8 L5,24 Z" />
    </group>
</vector>
