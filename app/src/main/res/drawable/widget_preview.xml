<?xml version="1.0" encoding="utf-8"?>
<!--
  Widget 选择器里的预览图（API 31+ 的 previewImage；低版本忽略）。
  用 layer-list 画一张"缩略 widget"：底色 + 标题行 + 四行示意（圆圈 + 两条横杠）。
  不用位图：一张 png 要切多套 dpi，这种纯色示意画不出来也维护不动。
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_bg" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item android:gravity="center_vertical" android:start="16dp" android:end="16dp">
        <layer-list>
            <!-- 标题 -->
            <item android:gravity="top|center_horizontal" android:top="14dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/widget_text" />
                    <corners android:radius="2dp" />
                    <size android:width="52dp" android:height="8dp" />
                </shape>
            </item>
            <!-- 行 1 -->
            <item android:top="34dp">
                <shape android:shape="oval">
                    <stroke android:width="2dp" android:color="@color/widget_circle_stroke" />
                    <size android:width="14dp" android:height="14dp" />
                </shape>
            </item>
            <item android:top="34dp" android:start="26dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/widget_text_secondary" />
                    <corners android:radius="2dp" />
                    <size android:width="120dp" android:height="7dp" />
                </shape>
            </item>
            <!-- 行 2 -->
            <item android:top="62dp">
                <shape android:shape="oval">
                    <stroke android:width="2dp" android:color="@color/widget_circle_stroke" />
                    <size android:width="14dp" android:height="14dp" />
                </shape>
            </item>
            <item android:top="62dp" android:start="26dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/widget_text_secondary" />
                    <corners android:radius="2dp" />
                    <size android:width="96dp" android:height="7dp" />
                </shape>
            </item>
            <!-- 行 3 -->
            <item android:top="90dp">
                <shape android:shape="oval">
                    <stroke android:width="2dp" android:color="@color/widget_circle_stroke" />
                    <size android:width="14dp" android:height="14dp" />
                </shape>
            </item>
            <item android:top="90dp" android:start="26dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/widget_text_secondary" />
                    <corners android:radius="2dp" />
                    <size android:width="72dp" android:height="7dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</layer-list>
